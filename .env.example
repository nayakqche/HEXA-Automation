# ============================================================
# HEXA Transmission Connectivity Agent – Configuration
# Copy this file to `.env` and fill in real values.
# ============================================================

# -------- Source (government website) --------
# Default: CTUIL (Central Transmission Utility of India Limited)
# "Connectivity to be Made Effective" page.
SOURCE_URL=https://www.ctuil.in/connectivity-effective-list

# Maximum pages to crawl (the CTUIL table is paginated, 10 rows/page).
# Set to 0 to crawl until no more rows.
MAX_PAGES=0

# Optional filters (case-insensitive substring). Leave blank for "no filter".
FILTER_REGION=
FILTER_STATE=
FILTER_TYPE=

# -------- Email (SMTP) --------
# Examples below. Use Gmail App Passwords (not your account password).
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your.bot@gmail.com
SMTP_PASSWORD=your_app_password_here

# From / To (To can be comma-separated for multiple recipients).
MAIL_FROM=HEXA Connectivity Bot <your.bot@gmail.com>
MAIL_TO=you@example.com

# -------- Schedule --------
# 24-hour clock. Default 23:00 (11 PM) in TIMEZONE.
RUN_HOUR=23
RUN_MINUTE=0
TIMEZONE=Asia/Kolkata

# -------- Storage --------
# Where to persist the previous snapshot (used for diffing).
DATA_DIR=./data

# -------- Behaviour --------
# If true, no email is sent – the report is printed/logged only.
DRY_RUN=false
# Send an email even when the data is unchanged from yesterday.
SEND_ON_NO_CHANGE=true
